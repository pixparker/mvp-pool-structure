# GlitchTip stack env — MVP-E28-F17. Copy to `.env`, fill the secrets, chmod 600.
#   cp .env.example .env && chmod 600 .env
# Bring up:  docker compose --env-file .env up -d

# Pin to a verified current stable tag — DO NOT use `latest`.
# Check releases: https://gitlab.com/glitchtip/glitchtip/-/releases
GLITCHTIP_IMAGE_TAG=v4.1

# Shared Postgres on mvpool_data. Create the DB + role first (README §2):
#   CREATE ROLE glitchtip LOGIN PASSWORD '<pw>';
#   CREATE DATABASE glitchtip OWNER glitchtip;
DATABASE_URL=postgres://glitchtip:CHANGE_ME@postgres:5432/glitchtip

# Shared Redis on mvpool_data — dedicated DB index 3 so GlitchTip's celery keys
# don't collide with other pool apps on the same Redis.
REDIS_URL=redis://redis:6379/3

# Django secret key. Generate:  openssl rand -hex 50
SECRET_KEY=CHANGE_ME

# Public URL of this instance (links, CSRF, ingest origin).
GLITCHTIP_DOMAIN=https://errors.mizro.ir

# Error retention (days). Worker purges events older than this.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90

# Email. consolemail:// just logs invite links to the worker's stdout — fine for
# invite-only V1. For real email set an SMTP URL: smtp://user:pass@host:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=errors@mizro.ir
